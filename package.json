  "scripts": {
    "start": "react-dotenv && cross-env REACT_APP_BACKEND=http://localhost:5000/api react-scripts -r @cypress/instrument-cra start",
    "build": "react-dotenv && react-scripts build",
    "serve": "react-dotenv && serve build",
    "test:coverage": "cross-env NODE_ENV=test REACT_APP_BACKEND=http://localhost:5000/api NODE_OPTIONS=--experimental-vm-modules jest --forceExit --coverage",
    "test:cypress": "cypress run",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.9.12",
    "@cypress/instrument-cra": "^1.4.0",
    "babel-plugin-istanbul": "^6.1.1",
    "cypress": "^13.17.0",
    "cypress-wait-until": "^1.7.2",
    "nyc": "^15.1.0",
    "react-scripts": "^5.0.1"
  }
